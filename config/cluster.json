{
  "env": "dev",
  "debug": true,
  "print_level": "info",
  "include": [
    "include/logger.json",
    "include/data-config.json",
    "include/db.json"
  ],
  "@include": "include用于引用其他的配置文件。多环境配置的开发过程中可以抽像一些通用的配置",
  "cluster": {
    "discovery": {
      "mode": "nats",
      "@mode1": "mode=default,从profile-{x}.json读取node节点的配置数据",
      "@mode2": "mode=nats,通过nats->master_node_id获取已注册的节点",
      "@mode3": "mode=etcd,通过etcd同步已注册节点"
    },
    "nats": {
      "master_node_id": "gc-master",
      "address": "nats://127.0.0.1:4222",
      "reconnect_delay": 1,
      "max_reconnects": 0,
      "request_timeout": 2,
      "user": "",
      "password": ""
    }
  },
  "node": {
    "master": [
      {
        "node_id": "gc-master",
        "address": "",
        "__settings__": {
          "ref_logger": "master_log"
        },
        "enable": true
      }
    ],
    "center": [
      {
        "node_id": "gc-center",
        "address": "",
        "__settings__": {
          "db_id_list": {
            "center_db_id": "center_db_1"
          },
          "ref_logger": "center_log"
        },
        "enable": true
      }
    ],
    "gate": [
      {
        "node_id": "^gc-gate-\\d+$",
        "address": ":10010",
        "__settings__": {
          "db_id_list": {
            "game_db_id": "game_db_1"
          },
          "ref_logger": "gate_log"
        },
        "enable": true
      }
    ],
    "web": [
      {
        "node_id": "gc-web-1",
        "address": "127.0.0.1:8081",
        "__settings__": {
          "ref_logger": "web_log"
        },
        "enable": true
      }
    ],
    "game": [
      {
        "node_id": "^\\d+$",
        "__settings__": {
          "db_id_list": {
            "game_db_id": "game_db_1"
          },
          "ref_logger": "game_log"
        },
        "enable": true
      }
    ]
  }
}